# Copia este archivo a .env.local y completa los valores.
# Ambas variables son públicas por diseño: la clave publicable está pensada
# para el navegador y la protegen las políticas a nivel de fila (RN-12).
#
# NUNCA agregues aquí la clave service_role ni ningún secreto con prefijo
# NEXT_PUBLIC_ (REGLAS §4).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor (sin prefijo público): URL de Tino API.
TINO_API_URL=http://localhost:4000

# Solo para /revisar-pantalla (QA local): cuenta de PRUEBA, nunca la real.
# Sin prefijo público. Nunca se versiona con valores.
TINO_QA_CORREO=
TINO_QA_CLAVE=
